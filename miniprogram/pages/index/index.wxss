.app {
  box-sizing: border-box;
  height: 100vh;
  background: #ffffff;
}

.screen {
  box-sizing: border-box;
  height: 100%;
  padding: 32rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.screen-select {
  padding-top: 58rpx;
}

.select-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-title {
  font-size: 60rpx;
  line-height: 1.15;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.screen-title {
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 650;
}

.select-title {
  margin-top: 72rpx;
}

.screen-subtitle {
  margin-top: 24rpx;
  color: #747b78;
  font-size: 28rpx;
  line-height: 1.55;
  text-align: center;
}

.select-illustration {
  width: 390rpx;
  height: 390rpx;
  margin-top: 36rpx;
}

.direction-switch {
  display: flex;
  width: 420rpx;
  margin-top: 34rpx;
  padding: 6rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f0f4f2;
}

.direction-option {
  flex: 1;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 17rpx;
  background: transparent;
  color: #66706c;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.direction-option.active {
  background: #ffffff;
  color: #078e83;
  box-shadow: 0 6rpx 18rpx rgba(17, 50, 46, 0.09);
}

.direction-option::after {
  border: 0;
}

.bottom-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.select-actions {
  margin-top: auto;
}

.primary-button,
.secondary-button,
.outline-button,
.text-button,
.square-button,
.icon-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #101211;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1;
}

.primary-button {
  width: 100%;
  height: 104rpx;
  gap: 16rpx;
  border-radius: 28rpx;
  background: #08a99b;
  color: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(8, 169, 155, 0.16);
}

.primary-button:active {
  background: #078e83;
}

.primary-button image,
.secondary-button image {
  width: 40rpx;
  height: 40rpx;
}

.secondary-button {
  width: 100%;
  height: 96rpx;
  gap: 14rpx;
  border: 2rpx solid #e0e5e3;
  border-radius: 24rpx;
  background: #ffffff;
}

.helper-text {
  margin-top: 2rpx;
  color: #747b78;
  font-size: 25rpx;
  line-height: 1.4;
  text-align: center;
}

.selected-list {
  box-sizing: border-box;
  width: 100%;
  max-height: 48vh;
  margin-top: 42rpx;
  padding: 2rpx;
}

.selected-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 14rpx 6rpx;
  border-bottom: 2rpx solid #eef1f0;
}

.order-number {
  width: 40rpx;
  color: #08a99b;
  font-size: 24rpx;
  font-weight: 700;
}

.selected-thumb {
  width: 72rpx;
  height: 88rpx;
  border: 2rpx solid #e5e9e7;
  border-radius: 12rpx;
}

.selected-meta {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-left: 20rpx;
}

.selected-name {
  font-size: 27rpx;
  font-weight: 600;
}

.selected-size {
  color: #8a908e;
  font-size: 22rpx;
}

.row-actions {
  display: flex;
  gap: 6rpx;
}

.icon-button {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
}

.icon-button image {
  width: 30rpx;
  height: 30rpx;
}

.icon-button[disabled] {
  opacity: 0.25;
}

.icon-button.danger {
  background: #fff5f5;
}

.top-title {
  width: 100%;
  margin-top: 8rpx;
  font-size: 38rpx;
  line-height: 1.25;
  font-weight: 700;
  text-align: center;
}

.processing-screen {
  justify-content: center;
}

.processing-screen .top-title {
  position: absolute;
  top: calc(32rpx + var(--status-bar-height, 0px));
}

.processing-visual {
  position: relative;
  width: 360rpx;
  height: 330rpx;
}

.scan-card {
  position: absolute;
  left: 76rpx;
  width: 208rpx;
  height: 268rpx;
  border: 2rpx solid #dfe7e4;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(19, 55, 50, 0.07);
}

.scan-card::before,
.scan-card::after {
  content: "";
  position: absolute;
  left: 26rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #e7ecea;
}

.scan-card::before {
  top: 66rpx;
  width: 130rpx;
  box-shadow: 0 34rpx #edf1f0, 0 68rpx #e7ecea;
}

.scan-card::after {
  top: 82rpx;
  width: 92rpx;
  box-shadow: 0 68rpx #edf1f0;
}

.scan-card-one {
  top: 0;
  transform: rotate(-4deg);
}

.scan-card-two {
  top: 56rpx;
  transform: rotate(4deg);
}

.scan-line {
  position: absolute;
  top: 155rpx;
  left: 40rpx;
  width: 280rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #08a99b;
  box-shadow: 0 0 24rpx rgba(8, 169, 155, 0.45);
  animation: scan 1.8s ease-in-out infinite alternate;
}

@keyframes scan {
  from { transform: translateY(-86rpx); }
  to { transform: translateY(86rpx); }
}

.processing-progress {
  margin-top: 36rpx;
  color: #08a99b;
  font-size: 56rpx;
  font-weight: 700;
}

.progress-track {
  width: 520rpx;
  height: 10rpx;
  margin-top: 38rpx;
  overflow: hidden;
  border-radius: 5rpx;
  background: #edf2f0;
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: #08a99b;
  transition: width 180ms ease-out;
}

.text-button {
  height: 80rpx;
  margin-top: 30rpx;
  padding: 0 32rpx;
  color: #747b78;
  font-size: 27rpx;
}

.preview-screen {
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.preview-scroll {
  width: 100%;
  height: 0;
  min-height: 0;
  flex: 1;
  margin-top: 30rpx;
  background: #f7f9f8;
  border-radius: 26rpx;
}

.overview-image {
  display: block;
  margin: 24rpx auto;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(17, 50, 46, 0.09);
}

.overview-image.horizontal {
  margin-left: 24rpx;
  margin-right: 24rpx;
}

.preview-loading {
  display: flex;
  min-height: 360rpx;
  align-items: center;
  justify-content: center;
  color: #747b78;
  font-size: 26rpx;
}

.removed-status {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.removed-status image {
  width: 38rpx;
  height: 38rpx;
}

.seam-controller {
  width: 100%;
  flex-shrink: 0;
  margin-top: 22rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 2rpx solid #e2e7e5;
  border-radius: 26rpx;
  background: #ffffff;
}

.seam-navigation {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.square-button {
  width: 74rpx;
  height: 74rpx;
  border: 2rpx solid #e0e5e3;
  border-radius: 18rpx;
}

.square-button image {
  width: 28rpx;
  height: 28rpx;
}

.square-button[disabled] {
  opacity: 0.3;
}

.button-row {
  display: flex;
  gap: 18rpx;
  width: 100%;
}

.seam-controller .button-row {
  margin-top: 18rpx;
}

.outline-button,
.primary-button.compact {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
}

.outline-button {
  border: 2rpx solid #08a99b;
  color: #078e83;
}

.manual-subtitle {
  margin-top: 18rpx;
}

.crop-preview-row {
  display: flex;
  gap: 18rpx;
  width: 100%;
  margin-top: 34rpx;
}

.crop-panel {
  position: relative;
  flex: 1;
  height: 470rpx;
  overflow: hidden;
  border: 2rpx solid #e0e5e3;
  border-radius: 22rpx;
  background: #f6f8f7;
}

.crop-image {
  width: 100%;
  height: 100%;
}

.crop-shade {
  position: absolute;
  left: 0;
  right: 0;
  background: rgba(16, 18, 17, 0.32);
}

.crop-shade.bottom {
  bottom: 0;
}

.crop-shade.top {
  top: 0;
}

.crop-shade.left {
  top: 0;
  right: auto;
  bottom: 0;
  left: 0;
}

.crop-shade.right {
  top: 0;
  right: 0;
  bottom: 0;
  left: auto;
}

.crop-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 4rpx;
  margin-top: -2rpx;
  background: #08a99b;
  box-shadow: 0 0 14rpx rgba(8, 169, 155, 0.55);
}

.crop-line.horizontal {
  top: 0;
  right: auto;
  bottom: 0;
  width: 4rpx;
  height: auto;
  margin-top: 0;
  margin-left: -2rpx;
}

.crop-preview-row.horizontal .crop-panel {
  height: 330rpx;
}

.crop-label {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #078e83;
  font-size: 21rpx;
  font-weight: 600;
}

.slider-group {
  width: 100%;
  margin-top: 32rpx;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f7f9f8;
}

.slider-title {
  display: block;
  margin-bottom: 10rpx;
  color: #4f5754;
  font-size: 25rpx;
  font-weight: 600;
}

.manual-sliders .slider-title:not(:first-child) {
  margin-top: 18rpx;
}

.order-fix-button {
  width: 100%;
  height: 82rpx;
  margin-top: 22rpx;
}

.preview-order-fix {
  margin-top: 0;
  margin-bottom: 16rpx;
}

.manual-actions {
  flex-direction: row;
  margin-top: auto;
}

.manual-actions button {
  flex: 1;
}

.complete-screen {
  padding-left: 48rpx;
  padding-right: 48rpx;
}

.result-preview-shell {
  width: 330rpx;
  flex: 1;
  min-height: 0;
  margin-top: 34rpx;
  overflow: hidden;
  border: 2rpx solid #dfe5e2;
  border-radius: 20rpx;
  background: #f6f8f7;
  box-shadow: 0 16rpx 42rpx rgba(17, 50, 46, 0.08);
}

.result-preview {
  width: 100%;
}

.result-preview-shell.horizontal {
  width: 100%;
  max-height: 330rpx;
}

.result-preview.horizontal {
  width: auto;
  height: 100%;
}

.result-status {
  margin-top: 24rpx;
}

.result-size {
  margin-top: 12rpx;
  color: #7a817f;
  font-size: 23rpx;
}

.complete-actions {
  margin-top: 28rpx;
}

.privacy-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #7c8380;
  font-size: 23rpx;
}

.privacy-note image {
  width: 28rpx;
  height: 28rpx;
}

.error-screen {
  justify-content: center;
}

.error-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 36rpx;
  border-radius: 56rpx;
  background: #fff0f0;
  color: #d84f4f;
  font-size: 58rpx;
  font-weight: 700;
}

.error-message {
  max-width: 560rpx;
}

.error-retry {
  width: 420rpx;
  margin-top: 54rpx;
}

.privacy-overlay {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(16, 18, 17, 0.48);
}

.privacy-dialog {
  width: 100%;
  padding: 44rpx 36rpx 36rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 70rpx rgba(17, 50, 46, 0.18);
}

.privacy-title {
  display: block;
  color: #101211;
  font-size: 36rpx;
  font-weight: 650;
  text-align: center;
}

.privacy-description {
  display: block;
  margin-top: 28rpx;
  color: #5f6764;
  font-size: 27rpx;
  line-height: 1.65;
}

.privacy-contract-link {
  margin: 18rpx 0 0;
  padding: 12rpx 0;
  background: transparent;
  color: #078e83;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: left;
}

.privacy-actions {
  margin-top: 32rpx;
}

.privacy-actions .primary-button,
.privacy-actions .secondary-button {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.export-canvas {
  position: fixed;
  left: -10000px;
  top: -10000px;
  width: 1px;
  height: 1px;
  pointer-events: none;
}

.overview-canvas-buffer {
  position: fixed;
  left: -10000px;
  top: -10000px;
  width: 228px;
  pointer-events: none;
  opacity: 0;
}

@media (prefers-reduced-motion: reduce) {
  .scan-line {
    animation: none;
  }

  .progress-value {
    transition: none;
  }
}
